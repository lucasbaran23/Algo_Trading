# off = single user on your own computer, everything unlocked; on = hosted with accounts and plans (docs/DEPLOY.md)
AUTH_MODE=off
LOCAL_TIER=ultimate
# Hosted mode only:
PUBLIC_URL=http://localhost:8000
ADMIN_EMAILS=
COOKIE_SECURE=auto
# DATABASE_PATH=backend/.data/app.db
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ULTIMATE=

# sim = offline deterministic demo data
# live = real data, no keys needed for NG: Yahoo (prices, 1-minute bars, futures curve; ~10-min delayed),
#        EIA storage (ir.eia.gov), CFTC COT, Open-Meteo weather, Google/Yahoo news. Falls back to sim per source.
DATA_MODE=sim
# Markets polled every 30 s with full 1-minute bars in live mode (others every 2 min, last price only)
LIVE_FOCUS=NG
# Databento (https://databento.com/signup): years of real CME 1-minute bars. Optional, pay-as-you-go
# (free credit on signup). Max spend per request in USD, and how many years to backfill automatically.
DATABENTO_API_KEY=
DATABENTO_MAX_USD=5
DATABENTO_YEARS=2
# Free key from https://www.eia.gov/opendata/register.php. Needed for crude, gasoline and distillate stocks
# (CL/RB/HO). Natural gas storage works without it.
EIA_API_KEY=
TICK_INTERVAL_S=1.0
SIGNAL_INTERVAL_S=15

# Broker routing for prop accounts. Paper trading always works; live routing is OFF by default.
LIVE_TRADING_ENABLED=false
BROKER=paper            # paper | tradovate | projectx
TRADOVATE_ENV=demo
TRADOVATE_USER=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_CID=
TRADOVATE_SECRET=
PROJECTX_BASE_URL=
PROJECTX_USER=
PROJECTX_API_KEY=

# News feed. In live mode: Google News + Yahoo Finance RSS per market (free, headlines + links).
NEWS_POLL_S=120
# Extra RSS feeds, comma-separated
NEWS_FEEDS=
# rules (free, instant, explainable) | claude (AI classifier; needs ANTHROPIC_API_KEY or `ant auth login`)
NEWS_CLASSIFIER=rules
# Model for the AI classifier (default claude-opus-5-5)
NEWS_LLM_MODEL=

# Trade-signal notifications (optional). Messages go to YOUR channels only.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SIGNAL_WEBHOOK_URL=
# created,activated,tp1,closed
NOTIFY_EVENTS=activated,tp1,closed
