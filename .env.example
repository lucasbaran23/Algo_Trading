# sim = offline deterministic demo data; live = CFTC / EIA / Yahoo with per-source fallback to sim
DATA_MODE=sim
# Free key from https://www.eia.gov/opendata/register.php (weekly crude, gasoline, distillate, nat gas storage)
EIA_API_KEY=
TICK_INTERVAL_S=1.0
SIGNAL_INTERVAL_S=15

# Broker routing for prop accounts. Paper trading always works; live routing is OFF by default.
LIVE_TRADING_ENABLED=false
BROKER=paper            # paper | tradovate | projectx
TRADOVATE_ENV=demo
TRADOVATE_USER=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_CID=
TRADOVATE_SECRET=
PROJECTX_BASE_URL=
PROJECTX_USER=
PROJECTX_API_KEY=
